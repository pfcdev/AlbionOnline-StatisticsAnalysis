<UserControl x:Class="StatisticsAnalysisTool.UserControls.MarketOrdersControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1050"
             d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">
    <UserControl.Resources>
        <Style x:Key="MarketOrders.Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.T.2}" />
            <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Border.1}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="MarketOrders.Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.4}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <DataTemplate x:Key="MarketOrders.ItemCell">
            <StackPanel Orientation="Horizontal" Margin="0,3">
                <Border Width="42" Height="42" Margin="0,0,8,0"
                        Background="{StaticResource SolidColorBrush.Background.4}"
                        BorderBrush="{StaticResource SolidColorBrush.Border.1}"
                        BorderThickness="1">
                    <Image Source="{Binding Icon}" Width="40" Height="40" Stretch="Uniform" />
                </Border>
                <StackPanel VerticalAlignment="Center" Width="145">
                    <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold"
                               Foreground="{StaticResource SolidColorBrush.Text.1}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ItemTypeId}" />
                    <TextBlock Text="{Binding TierAndQuality}" FontSize="11"
                               Foreground="{StaticResource SolidColorBrush.Accent.Yellow.0}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="MarketOrders.NumericCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.2}" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="CANLI PAZAR EMİRLERİ" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource SolidColorBrush.Text.1}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding MarketOrdersBindings.CurrentMarketName}"
                               Foreground="{StaticResource SolidColorBrush.Accent.Yellow.0}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="  •  " Foreground="{StaticResource SolidColorBrush.Text.5}" />
                    <TextBlock Text="{Binding MarketOrdersBindings.CurrentItemName}"
                               Foreground="{StaticResource SolidColorBrush.Text.3}" />
                </StackPanel>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding MarketOrdersBindings.LastUpdatedText}"
                       VerticalAlignment="Bottom"
                       Foreground="{StaticResource SolidColorBrush.Text.5}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MarketOrders.Panel}"
                    BorderBrush="{StaticResource SolidColorBrush.Accent.Orange.5}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="SELL ORDERS" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource SolidColorBrush.Accent.Orange.2}" />
                    <Grid Grid.Row="1" Margin="0,10,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Maksimum birim fiyat" VerticalAlignment="Center"
                                   Foreground="{StaticResource SolidColorBrush.Text.3}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding MarketOrdersBindings.MaximumSellOrderPrice, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Örnek: 125000 veya 125.000" />
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding MarketOrdersBindings.SellSummary}"
                               Foreground="{StaticResource SolidColorBrush.Text.2}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource MarketOrders.Panel}"
                    BorderBrush="{StaticResource SolidColorBrush.Accent.Blue.5}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="BUY ORDERS" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" />
                    <Grid Grid.Row="1" Margin="0,10,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Maksimum birim fiyat" VerticalAlignment="Center"
                                   Foreground="{StaticResource SolidColorBrush.Text.3}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding MarketOrdersBindings.MaximumBuyOrderPrice, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Örnek: 125000 veya 125.000" />
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding MarketOrdersBindings.BuySummary}"
                               Foreground="{StaticResource SolidColorBrush.Text.2}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MarketOrders.Panel}" Padding="8">
                <ListView ItemsSource="{Binding MarketOrdersBindings.SellOrders}"
                          HorizontalContentAlignment="Stretch"
                          ToolTip="İlanın üzerinde bekleyerek son kullanma tarihini görebilirsiniz.">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Ürün" Width="205" CellTemplate="{StaticResource MarketOrders.ItemCell}" />
                            <GridViewColumn Header="Adet" Width="55">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Amount, StringFormat={}{0:N0}}" Style="{StaticResource MarketOrders.NumericCell}"
                                                   ToolTip="{Binding ExpiresDisplay, StringFormat='Bitiş: {0}'}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Birim" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N0}}" Style="{StaticResource MarketOrders.NumericCell}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Toplam" Width="105">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:N0}}" Style="{StaticResource MarketOrders.NumericCell}"
                                                   Foreground="{StaticResource SolidColorBrush.Accent.Yellow.0}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource MarketOrders.Panel}" Padding="8">
                <ListView ItemsSource="{Binding MarketOrdersBindings.BuyOrders}"
                          HorizontalContentAlignment="Stretch"
                          ToolTip="İlanın üzerinde bekleyerek son kullanma tarihini görebilirsiniz.">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Ürün" Width="205" CellTemplate="{StaticResource MarketOrders.ItemCell}" />
                            <GridViewColumn Header="Adet" Width="55">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Amount, StringFormat={}{0:N0}}" Style="{StaticResource MarketOrders.NumericCell}"
                                                   ToolTip="{Binding ExpiresDisplay, StringFormat='Bitiş: {0}'}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Birim" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N0}}" Style="{StaticResource MarketOrders.NumericCell}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Toplam" Width="105">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:N0}}" Style="{StaticResource MarketOrders.NumericCell}"
                                                   Foreground="{StaticResource SolidColorBrush.Accent.Yellow.0}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>
    </Grid>
</UserControl>
