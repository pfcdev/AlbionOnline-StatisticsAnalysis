<UserControl x:Class="StatisticsAnalysisTool.UserControls.MarketActivityControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">
    <UserControl.Resources>
        <Style x:Key="MarketActivity.Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.T.2}" />
            <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Border.1}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="MarketActivity.Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.5}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="MarketActivity.Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MarketActivity.NumericCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.2}" />
            <Setter Property="Padding" Value="4,0" />
        </Style>

        <DataTemplate x:Key="MarketActivity.ItemCell">
            <StackPanel Orientation="Horizontal" Margin="0,3">
                <Border Width="42" Height="42" Margin="0,0,8,0"
                        Background="{StaticResource SolidColorBrush.Background.4}"
                        BorderBrush="{StaticResource SolidColorBrush.Border.1}"
                        BorderThickness="1">
                    <Image Source="{Binding Icon}" Width="40" Height="40" Stretch="Uniform" />
                </Border>
                <StackPanel VerticalAlignment="Center" Width="190">
                    <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold"
                               Foreground="{StaticResource SolidColorBrush.Text.1}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ItemTypeId}" />
                    <TextBlock Text="{Binding TierAndQuality}" FontSize="11"
                               Foreground="{StaticResource SolidColorBrush.Accent.Yellow.0}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MarketActivity.TypeCell">
            <TextBlock Text="{Binding ActivityType}" VerticalAlignment="Center" FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Green.2}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPurchase}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Orange.2}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="MarketActivity.BalanceCell">
            <TextBlock Text="{Binding BalanceChangeDisplay}" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Green.2}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPurchase}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.2}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="PAZAR HAREKETLERİ" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource SolidColorBrush.Text.1}" />
                <TextBlock Text="Son alınan ve satılan ürünler; şehir, fiyat ve bakiye ayrıntılarıyla kalıcı olarak tutulur."
                           Margin="0,4,0,0" Foreground="{StaticResource SolidColorBrush.Text.4}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding MarketActivityBindings.ActivitySummary}"
                       VerticalAlignment="Bottom" Foreground="{StaticResource SolidColorBrush.Text.5}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MarketActivity.Panel}"
                    BorderBrush="{StaticResource SolidColorBrush.Accent.Yellow.5}">
                <StackPanel>
                    <TextBlock Text="GÜNCEL BAKİYE" Style="{StaticResource MarketActivity.Caption}" />
                    <TextBlock Text="{Binding MarketActivityBindings.CurrentSilverDisplay}"
                               Style="{StaticResource MarketActivity.Value}"
                               Foreground="{StaticResource SolidColorBrush.Accent.Yellow.0}" />
                    <TextBlock Text="{Binding MarketActivityBindings.BalanceLastUpdatedText}"
                               Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource SolidColorBrush.Text.5}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource MarketActivity.Panel}"
                    BorderBrush="{StaticResource SolidColorBrush.Accent.Orange.5}">
                <StackPanel>
                    <TextBlock Text="SATIN ALIMLAR" Style="{StaticResource MarketActivity.Caption}" />
                    <TextBlock Text="{Binding MarketActivityBindings.PurchaseSummary}"
                               Style="{StaticResource MarketActivity.Value}"
                               Foreground="{StaticResource SolidColorBrush.Accent.Orange.2}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource MarketActivity.Panel}"
                    BorderBrush="{StaticResource SolidColorBrush.Accent.Green.5}">
                <StackPanel>
                    <TextBlock Text="SATIŞLAR" Style="{StaticResource MarketActivity.Caption}" />
                    <TextBlock Text="{Binding MarketActivityBindings.SalesSummary}"
                               Style="{StaticResource MarketActivity.Value}"
                               Foreground="{StaticResource SolidColorBrush.Accent.Green.2}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource MarketActivity.Panel}" Padding="10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding MarketActivityBindings.SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Ürün, şehir/map, tier, hareket türü veya fiyat ara" />
                <CheckBox Grid.Column="1" Content="Satın alımlar" IsChecked="{Binding MarketActivityBindings.ShowPurchases}"
                          Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SolidColorBrush.Accent.Orange.2}" />
                <CheckBox Grid.Column="2" Content="Satışlar" IsChecked="{Binding MarketActivityBindings.ShowSales}"
                          Margin="16,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource SolidColorBrush.Accent.Green.2}" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource MarketActivity.Panel}" Padding="8">
            <ListView x:Name="ActivityList"
                      ItemsSource="{Binding MarketActivityBindings.Activities}"
                      HorizontalContentAlignment="Stretch"
                      PreviewMouseLeftButtonUp="ActivityList_OnPreviewMouseLeftButtonUp">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Zaman" Width="125" DisplayMemberBinding="{Binding TimestampDisplay}" />
                        <GridViewColumn Header="Hareket" Width="150" CellTemplate="{StaticResource MarketActivity.TypeCell}" />
                        <GridViewColumn Header="Ürün" Width="250" CellTemplate="{StaticResource MarketActivity.ItemCell}" />
                        <GridViewColumn Header="Adet" Width="65">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Quantity, StringFormat={}{0:N0}}" Style="{StaticResource MarketActivity.NumericCell}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Birim fiyat" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N0}}" Style="{StaticResource MarketActivity.NumericCell}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Bakiye etkisi" Width="125" CellTemplate="{StaticResource MarketActivity.BalanceCell}" />
                        <GridViewColumn Header="Şehir / Map" Width="175" DisplayMemberBinding="{Binding LocationName}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <Popup x:Name="ActivityDetailsPopup"
               PlacementTarget="{Binding ElementName=ActivityList}"
               Placement="Center"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="False">
            <Border Width="430" Padding="18"
                    Background="{StaticResource SolidColorBrush.Background.2}"
                    BorderBrush="{StaticResource SolidColorBrush.Accent.Yellow.5}"
                    BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="58" Height="58" Margin="0,0,12,0"
                                Background="{StaticResource SolidColorBrush.Background.4}"
                                BorderBrush="{StaticResource SolidColorBrush.Border.1}" BorderThickness="1">
                            <Image Source="{Binding Icon}" Width="56" Height="56" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ItemName}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource SolidColorBrush.Text.1}" />
                            <TextBlock Text="{Binding TierAndQuality}" Foreground="{StaticResource SolidColorBrush.Accent.Yellow.0}" />
                            <TextBlock Text="{Binding ActivityType}" Foreground="{StaticResource SolidColorBrush.Text.3}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="✕" Width="30" Height="30"
                                Margin="12,0,0,0" VerticalAlignment="Top"
                                Click="CloseActivityDetailsPopup_OnClick"
                                ToolTip="Kapat" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Adet" Style="{StaticResource MarketActivity.Caption}" />
                        <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat={}{0:N0}}" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                        <TextBlock Grid.Row="1" Text="Birim fiyat" Style="{StaticResource MarketActivity.Caption}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UnitPriceDisplay}" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                        <TextBlock Grid.Row="2" Text="Brüt toplam" Style="{StaticResource MarketActivity.Caption}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GrossTotalDisplay}" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                        <TextBlock Grid.Row="3" Text="Vergi ve ücretler" Style="{StaticResource MarketActivity.Caption}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FeesDisplay}" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                        <TextBlock Grid.Row="4" Text="Bakiyeye net etkisi" Style="{StaticResource MarketActivity.Caption}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding BalanceChangeDisplay}" Foreground="{StaticResource SolidColorBrush.Accent.Yellow.0}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="5" Text="İşlem sonrası bakiye" Style="{StaticResource MarketActivity.Caption}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding BalanceAfterDisplay}" Foreground="{StaticResource SolidColorBrush.Accent.Yellow.0}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="6" Text="Şehir / Map" Style="{StaticResource MarketActivity.Caption}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LocationName}" Foreground="{StaticResource SolidColorBrush.Text.1}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="7" Text="Zaman" Style="{StaticResource MarketActivity.Caption}" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding TimestampDisplay}" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                    </Grid>

                    <TextBlock Grid.Row="2" Margin="0,13,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource SolidColorBrush.Text.5}"
                               Text="İşlem sonrası bakiye yalnızca uygulama açıkken yakalanan ve bakiye paketiyle eşleşen hareketlerde gösterilir. Kapatmak için sağ üstteki düğmeye basın veya aynı satıra tekrar tıklayın." />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
